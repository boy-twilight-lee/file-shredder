{
  "name": "file-shredder",
  "version": "1.0.0",
  "description": "A secure cross-platform file shredder for Windows and macOS.",
  "main": "dist-electron/main.js",
  "author": "文件粉碎精灵",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && electron-builder",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:win": "npm run build:win:x64",
    "build:win:x64": "npm run build:app && electron-builder --win nsis --x64 && python scripts/clean_release.py",
    "build:win:ia32": "npm run build:app && electron-builder --win nsis --ia32 && python scripts/clean_release.py",
    "build:mac": "npm run build:app && electron-builder --mac dmg zip --x64 --arm64",
    "build:mac:x64": "npm run build:app && electron-builder --mac dmg zip --x64",
    "build:mac:arm64": "npm run build:app && electron-builder --mac dmg zip --arm64",
    "build:x64": "npm run build:win:x64",
    "build:ia32": "npm run build:win:ia32",
    "build:dir": "vue-tsc --noEmit && vite build && electron-builder --dir",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@vueuse/core": "^14.4.0",
    "dayjs": "^1.11.23",
    "gsap": "^3.15.0",
    "lodash-es": "^4.18.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "fast-glob": "^3.3.3",
    "less": "^4.2.2",
    "prettier": "^3.9.6",
    "rcedit": "^4.0.1",
    "typescript": "^5.7.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.filetools.fileshredder",
    "productName": "文件粉碎精灵",
    "asar": true,
    "afterAllArtifactBuild": "scripts/after-all-artifact-build.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "src/assets/app-icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "src/assets/imgs",
        "to": "imgs",
        "filter": [
          "idle.webp"
        ]
      }
    ],
    "win": {
      "icon": "src/assets/app-icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "文件粉碎精灵安装程序.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "文件粉碎精灵",
      "installerIcon": "src/assets/app-icon.ico",
      "uninstallerIcon": "src/assets/app-icon.ico",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "src/assets/app-icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "File-Shredder-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "File-Shredder-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "文件粉碎精灵.${ext}"
    }
  }
}
